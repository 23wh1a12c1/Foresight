datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER") // "ADMIN" | "CUSTOMER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id          String   @id @default(uuid())
  make        String
  model       String
  category    String
  year        Int      @default(2024)
  price       Float
  quantity    Int      @default(0)
  status      String   @default("IN_STOCK") // "IN_STOCK" | "LOW_STOCK" | "SOLD_OUT" | "COMING_SOON"
  description String?
  imageUrl    String?
  horsepower  Int?
  zeroToSixty String?
  topSpeed    String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
